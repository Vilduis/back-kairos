APP_NAME=Kairos API
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+psycopg://postgres:CONTRASEÑA@localhost:5433/db_kairos

SEED_ADMINS=[{"full_name": "Admin", "email": "admin@ejemplo.com", "password": "CAMBIAR"}]

SECRET_KEY=generar-con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=60

FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=Kairos <noreply@vilduis.com>

MODEL_ARTIFACTS_DIR=artifacts
# Orden de intento de los proveedores LLM; si todos fallan se usan mensajes predefinidos.
LLM_PROVIDERS=["deepseek","gemini"]
LLM_TIMEOUT_SECONDS=20
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
